{
  "name": "jangteamjang-rental-landing",
  "private": true,
  "scripts": {
    "build:footer": "esbuild components/site-footer.tsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=assets/footer.js",
    "build:hero": "esbuild components/hero-parallax.ts --bundle --minify --format=iife --target=es2019 --outfile=assets/hero-parallax.js",
    "build": "npm run build:footer && npm run build:hero"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "gsap": "3.12.5",
    "@studio-freight/lenis": "1.0.42"
  }
}